{
  "name": "clovers-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "clovers 终端 Web 控制台 —— React 19 + Vite + Tailwind CSS v4 重构版",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
